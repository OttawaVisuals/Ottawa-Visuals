_site/
.sass-cache/
.DS_Store
Thumbs.db

# Personal / data exports — never commit
conversations.json
*.dms
data-*.zip

# Large source / working files (kept locally, not published by the site)
*.pbix
*.xlsx
*.xls
~$*

# OC Transpo scraper — output, logs, personal seed list, venv
OC_Transpo/data/
OC_Transpo/data_*/
OC_Transpo/meetings.txt
OC_Transpo/scraper.log
**/__pycache__/
.venv/

# Weather fetcher — raw/large CSVs and logs (the small indices JSON IS committed)
Weather/data/raw/
Weather/data/*.csv
Weather/weather_fetch.log
Weather/weather_fetch_hourly.log
Weather/lightning_fetch.log

# GIS shapefile components (the site uses the derived .json / geo.js)
*.shp
*.shx
*.dbf
*.sbn
*.sbx
*.cpg
*.prj

# City Hall eScribe indexer — output/logs
CityHall_Index/data/
CityHall_Index/data_*/
CityHall_Index/*.log

# Secrets for the Pi-hosted collectors — never commit (key lives in ~/.ottawa_visuals.env)
*.env
.ottawa_visuals.env

# PWHL play-by-play — 27 MB and rewritten daily; carried between CI runs via
# actions/cache + uploaded as a workflow artifact, not committed. The small
# derived PWHL/data/json/*.json the dashboard fetches IS committed.
PWHL/data/pwhl_pbp.csv

# OC Transpo GTFS-RT collector — rt_data/ summaries ARE committed, including
# the small official KPI xlsx snapshots (exception to the global *.xlsx rule)
!OC_Transpo/rt_data/kpi_snapshots/*.xlsx
